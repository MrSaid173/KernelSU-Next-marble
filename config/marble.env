SOURCE_REPO_DEFAULT=aosp-pablo/android_kernel_xiaomi_sm8450
SOURCE_REF_DEFAULT=16
DEFCONFIG_MODE_DEFAULT=gki_fragments
BASE_DEFCONFIG_DEFAULT=gki_defconfig
ARCH=arm64
OUT_DIR=out
RELEASE_DIR=release
DEVICE_NAME_1=marble
DEVICE_NAME_2=marblein
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_KERNEL_BRANCH=gki-android12-5.10
# Defaults track the LATEST upstream (like the managers in config/managers.json).
# resolve-refs.sh turns a branch name into the exact commit at run time and logs it
# (release/resolved-refs.env), so every build records what it really used.
# To pin a version, enter a commit/tag/branch in the workflow inputs `susfs_commit`
# and `nomount_ref` (or put one here).
# NOTE: SUSFS (kernel patch) and the manager must match. Example: SUSFS b1de873f
# (v2.3.0) expected the manager to define `fake_state`, which current
# pershoot/KernelSU-Next dev-susfs no longer does -> "undefined symbol: fake_state".
SUSFS_COMMIT="${SUSFS_COMMIT_OVERRIDE:-${SUSFS_KERNEL_BRANCH}}"
NOMOUNT_REPO=maxsteeel/nomount
NOMOUNT_REF="${NOMOUNT_REF_OVERRIDE:-master}"
ANDROID_CLANG_REPO=https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86
ANDROID_CLANG_REF=master-kernel-build-2021
ANDROID_CLANG_REF_COMMIT=6e3223f76384455acde43affde3df0ea9df66c0d
ANDROID_CLANG_VERSION=clang-r416183b
ANDROID_CLANG_2024_REF=main-kernel-build-2024
LLVM_22_1_8_URL=https://github.com/llvm/llvm-project/releases/download/llvmorg-22.1.8/LLVM-22.1.8-Linux-X64.tar.xz
LLVM_22_1_8_SHA256=df0e1ecf16caf3489a272a5eea4eec9b0d82878f6477fa309504f918a0006384
